<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Title>Generellem</Title>
		<Version>1.1.0</Version>
		<Authors>JoeAtGenerellemAI</Authors>
		<Company>Generellem, Inc.</Company>
		<Description>Open-Source RAG framework for C# and other .NET developers.</Description>
		<Copyright>Copyright 2024 Generellem, Inc.</Copyright>
		<PackageProjectUrl>https://github.com/JoeMayo/generellem</PackageProjectUrl>
		<PackageIcon>dp_social_G_400x400.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/JoeMayo/generellem</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>ai, generative ai, generellem, llm</PackageTags>
		<PackageReleaseNotes>1.1.0 adds hybrid search, reranking, image text and vision ingestion, streamed answers, sqlite-vec indexing, and the .NET 10 target. Package versions follow semantic versioning. Push a vMAJOR.MINOR.PATCH tag to publish a GitHub release.

1.0.0 was the first stable release, with file system, web, and OneDrive ingestion.</PackageReleaseNotes>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<Platforms>AnyCPU;x64</Platforms>
	  <UserSecretsId>20671967-4acd-4c9f-b5a8-de9373cdc972</UserSecretsId>
  </PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<TreatWarningsAsErrors>True</TreatWarningsAsErrors>
		<WarningsNotAsErrors>NU5104</WarningsNotAsErrors>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
	  <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
	  <WarningsNotAsErrors>NU5104</WarningsNotAsErrors>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<TreatWarningsAsErrors>True</TreatWarningsAsErrors>
		<WarningsNotAsErrors>NU5104</WarningsNotAsErrors>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
	  <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
	  <WarningsNotAsErrors>NU5104</WarningsNotAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
		<PackageReference Include="Azure.Search.Documents" Version="11.6.1" />
		<PackageReference Include="Azure.Storage.Blobs" Version="12.25.0" />
		<PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
		<PackageReference Include="HtmlAgilityPack" Version="1.12.2" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="10.0.14" />
		<PackageReference Include="Microsoft.Graph" Version="5.88.0" />
		<PackageReference Include="NPOI.HWPFCore" Version="2.3.0.1" />
		<PackageReference Include="PdfPig" Version="0.1.11" />
		<PackageReference Include="Polly.Core" Version="8.6.2" />
		<PackageReference Include="Qdrant.Client" Version="1.15.0" />
		<PackageReference Include="SharpZipLib" Version="1.4.2" />
		<PackageReference Include="SkiaSharp" Version="3.119.0" />
		<PackageReference Include="System.Drawing.Common" Version="10.0.14" />
		<PackageReference Include="Microsoft.Kiota.Abstractions" Version="1.22.2" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Native\sqlite-vec\osx-arm64\vec0.dylib" Pack="true" PackagePath="runtimes/osx-arm64/native/" />
		<None Include="Native\sqlite-vec\osx-x64\vec0.dylib" Pack="true" PackagePath="runtimes/osx-x64/native/" />
		<None Include="Native\sqlite-vec\linux-x64\vec0.so" Pack="true" PackagePath="runtimes/linux-x64/native/" />
		<None Include="Native\sqlite-vec\win-x64\vec0.dll" Pack="true" PackagePath="runtimes/win-x64/native/" />
		<None Include="Native\sqlite-vec\LICENSE" Pack="true" PackagePath="sqlite-vec/" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="dp_social_G_400x400.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>
</Project>
